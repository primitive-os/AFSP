{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticfinanceprotocol.org/schemas/v0.1/return-trip.schema.json",
  "title": "Return Trip confirmation",
  "description": "The institution's signed account-opening outcome returned to the platform's Return Trip API (§13.2, Appendix A.9).",
  "x-afsp-status": "v0.1",
  "type": "object",
  "properties": {
    "return_trip_type": {
      "const": "ACCOUNT_OPENING_CONFIRMATION"
    },
    "session_id": {
      "$ref": "common.schema.json#/$defs/session_id"
    },
    "package_id": {
      "$ref": "common.schema.json#/$defs/package_id"
    },
    "institution_id": {
      "type": "string"
    },
    "outcome": {
      "$ref": "common.schema.json#/$defs/return_trip_outcome"
    },
    "outcome_timestamp": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "opening_details": {
      "type": "object",
      "properties": {
        "product_category": {
          "$ref": "common.schema.json#/$defs/product_category"
        },
        "account_opened": {
          "type": "boolean",
          "description": "Matches outcome OPENED."
        },
        "funded_within_7_days": {
          "$ref": "common.schema.json#/$defs/unknown_or_bool"
        },
        "active_within_30_days": {
          "$ref": "common.schema.json#/$defs/unknown_or_bool"
        }
      },
      "required": [
        "product_category",
        "account_opened",
        "funded_within_7_days",
        "active_within_30_days"
      ]
    },
    "institution_signature": {
      "$ref": "common.schema.json#/$defs/signature_block"
    }
  },
  "required": [
    "return_trip_type",
    "session_id",
    "package_id",
    "institution_id",
    "outcome",
    "outcome_timestamp",
    "institution_signature"
  ]
}
